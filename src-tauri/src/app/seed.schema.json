{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Default configuration of one language",
  "description": "Every seed.<language>.json follows this schema, checked by the tests. It mirrors the configuration read by the backend (app/config/mod.rs) and the limits of its validation (app/config/validation.rs); the backend tests check that it follows their fields, required fields and limits, and that all seeds share their ids, numbers and Steam AppIds.",
  "type": "object",
  "required": ["recovery", "exercises", "games"],
  "additionalProperties": false,
  "properties": {
    "recovery": { "$ref": "#/$defs/seconds", "description": "Recovery after each exercise, in seconds." },
    "exercises": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/exercise" } },
    "games": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/game" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "pattern": "\\S", "maxLength": 300 },
    "positive": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "amount": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "count": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
    "draws": { "type": "integer", "minimum": 1, "maximum": 100 },
    "exercise": {
      "type": "object",
      "required": ["id", "name", "unit", "min", "max"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "unit": { "type": "string", "maxLength": 50 },
        "min": { "$ref": "#/$defs/amount" },
        "max": { "$ref": "#/$defs/amount" },
        "recovery": { "$ref": "#/$defs/seconds" },
        "enabled": { "type": "boolean" },
        "timed": { "enum": ["seconds", "minutes"] },
        "eachSide": { "type": "boolean" }
      }
    },
    "game": {
      "type": "object",
      "required": ["id", "name", "events"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "steamAppId": { "$ref": "#/$defs/positive" },
        "events": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/event" } }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "name", "draws"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "draws": { "$ref": "#/$defs/draws" },
        "maxPerSession": { "$ref": "#/$defs/amount" },
        "jokers": { "$ref": "#/$defs/count" }
      }
    }
  }
}
