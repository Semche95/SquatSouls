{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed",
  "title": "Default configuration",
  "description": "The default configuration is split into exercises.json (the global recovery and the exercises) and one file per game in games/, which follow exercisesFile and game, checked by the tests. Every text shown (names of exercises and events, units) is written in each language (text); game names, ids, numbers and Steam AppIds are written once. It mirrors the configuration read by the backend (app/config/mod.rs) and the limits of its validation (app/config/validation.rs); the backend tests check that it follows their fields, required fields and limits.",
  "$defs": {
    "exercisesFile": {
      "type": "object",
      "required": ["recovery", "exercises"],
      "additionalProperties": false,
      "properties": {
        "recovery": { "$ref": "#/$defs/seconds", "description": "Recovery after each exercise, in seconds." },
        "exercises": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/exercise" } }
      }
    },
    "languages": {
      "type": "object",
      "description": "A value per language of the interface: a new language is added here, then in every text and unit of the files.",
      "required": ["en", "fr"],
      "propertyNames": { "enum": ["en", "fr"] }
    },
    "text": { "$ref": "#/$defs/languages", "additionalProperties": { "$ref": "#/$defs/name" } },
    "unit": { "$ref": "#/$defs/languages", "additionalProperties": { "type": "string", "maxLength": 50 } },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "pattern": "\\S", "maxLength": 300 },
    "positive": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "amount": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "count": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
    "draws": { "type": "integer", "minimum": 1, "maximum": 100 },
    "exercise": {
      "type": "object",
      "required": ["id", "name", "unit", "min", "max"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "unit": { "$ref": "#/$defs/unit" },
        "min": { "$ref": "#/$defs/amount" },
        "max": { "$ref": "#/$defs/amount" },
        "recovery": { "$ref": "#/$defs/seconds" },
        "enabled": { "type": "boolean" },
        "timed": { "enum": ["seconds", "minutes"] },
        "eachSide": { "type": "boolean" }
      }
    },
    "game": {
      "type": "object",
      "required": ["id", "name", "events"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "Also the name of the game's file." },
        "name": { "$ref": "#/$defs/name" },
        "steamAppId": { "$ref": "#/$defs/positive" },
        "events": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/event" } }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "name", "draws"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "draws": { "$ref": "#/$defs/draws" },
        "maxPerSession": { "$ref": "#/$defs/amount" },
        "jokers": { "$ref": "#/$defs/count" }
      }
    }
  }
}
