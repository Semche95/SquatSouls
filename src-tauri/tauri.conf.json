{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squat Souls",
  "version": "../package.json",
  "identifier": "com.semche.squatsouls",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Squat Souls",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 560,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5NTU4OEZEQjYxOEM0MDIKUldRQ3hCaTIvWWhWeVluT0RHNm5kc2N5dnkxZHJZTk0zc1ZPbHpSU05QanY1bHFxQk12N0ozNVAK",
      "endpoints": [
        "https://github.com/Semche95/SquatSouls/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
