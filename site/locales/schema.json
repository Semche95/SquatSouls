{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site texts of one language",
  "description": "Every language file of site/locales/ follows this schema, checked by the tests: all its keys, no other, each text non-blank. A text with placeholders contains each of them and no other; a plural text separates its forms with |.",
  "type": "object",
  "required": ["repo", "tagline", "cta", "ctaAny", "free", "other", "altPlay", "playTitle", "play", "howTitle", "step1Title", "step1", "step2Title", "step2", "step3Title", "step3", "step4Title", "step4", "featuresTitle", "recoveryTitle", "recovery", "altRecovery", "historyTitle", "history", "altHistory", "programTitle", "program", "altProgram", "settingsTitle", "settings", "altSettings", "noInteraction", "jokers", "intensity", "shortcuts", "steam", "share", "languages", "downloadTitle", "installer", "windowsRequirements", "macosRequirements", "linuxRequirements", "macosBlocked", "macosStep1", "macosStep2", "macosStep3", "footer"],
  "additionalProperties": false,
  "properties": {
    "repo": { "$ref": "#/$defs/text" },
    "tagline": { "$ref": "#/$defs/text" },
    "cta": { "type": "string", "pattern": "^[^{}]*(?:\\{os\\}[^{}]*)*$", "allOf": [{ "pattern": "\\{os\\}" }] },
    "ctaAny": { "$ref": "#/$defs/text" },
    "free": { "$ref": "#/$defs/text" },
    "other": { "$ref": "#/$defs/text" },
    "altPlay": { "$ref": "#/$defs/text" },
    "playTitle": { "$ref": "#/$defs/text" },
    "play": { "$ref": "#/$defs/text" },
    "howTitle": { "$ref": "#/$defs/text" },
    "step1Title": { "$ref": "#/$defs/text" },
    "step1": { "$ref": "#/$defs/text" },
    "step2Title": { "$ref": "#/$defs/text" },
    "step2": { "$ref": "#/$defs/text" },
    "step3Title": { "$ref": "#/$defs/text" },
    "step3": { "$ref": "#/$defs/text" },
    "step4Title": { "$ref": "#/$defs/text" },
    "step4": { "$ref": "#/$defs/text" },
    "featuresTitle": { "$ref": "#/$defs/text" },
    "recoveryTitle": { "$ref": "#/$defs/text" },
    "recovery": { "$ref": "#/$defs/text" },
    "altRecovery": { "$ref": "#/$defs/text" },
    "historyTitle": { "$ref": "#/$defs/text" },
    "history": { "$ref": "#/$defs/text" },
    "altHistory": { "$ref": "#/$defs/text" },
    "programTitle": { "$ref": "#/$defs/text" },
    "program": { "$ref": "#/$defs/text" },
    "altProgram": { "$ref": "#/$defs/text" },
    "settingsTitle": { "$ref": "#/$defs/text" },
    "settings": { "$ref": "#/$defs/text" },
    "altSettings": { "$ref": "#/$defs/text" },
    "noInteraction": { "$ref": "#/$defs/text" },
    "jokers": { "$ref": "#/$defs/text" },
    "intensity": { "$ref": "#/$defs/text" },
    "shortcuts": { "$ref": "#/$defs/text" },
    "steam": { "$ref": "#/$defs/text" },
    "share": { "$ref": "#/$defs/text" },
    "languages": { "$ref": "#/$defs/text" },
    "downloadTitle": { "$ref": "#/$defs/text" },
    "installer": { "$ref": "#/$defs/text" },
    "windowsRequirements": { "$ref": "#/$defs/text" },
    "macosRequirements": { "$ref": "#/$defs/text" },
    "linuxRequirements": { "$ref": "#/$defs/text" },
    "macosBlocked": { "$ref": "#/$defs/text" },
    "macosStep1": { "$ref": "#/$defs/text" },
    "macosStep2": { "$ref": "#/$defs/text" },
    "macosStep3": { "$ref": "#/$defs/text" },
    "footer": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "^[^{}]*\\S[^{}]*$" },
    "plural": { "type": "string", "pattern": "^[^{}]*\\|[^{}]*$" }
  }
}
